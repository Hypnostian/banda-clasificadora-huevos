# Copia este archivo a backend/.env y ajusta lo que necesites.
# Todo tiene default razonable: el sistema arranca sin .env.

# ---------------------------------------------------------------- modelo
MODELO_PATH=modelos/best.onnx
# Nombre que muestran /salud y la app (vacio = nombre del archivo)
MODELO_NOMBRE=
MODELO_IMGSZ=640
# En una instancia de 2 vCPU pon 2. En 0 deja que onnxruntime decida.
HILOS_INFERENCIA=2

# ------------------------------------------------------ politica de ruteo
# Modelo 1 (YOLOv8m): TAU_ROTO=0.35 TAU_SANO=0.85, sin banda.
# v3 (YOLOv8l):      TAU_ROTO=0.35 TAU_SANO=0.75 TAU_REVISION=0.07 (docs/COMPARACION_V1_V3.md)
CONF_MIN_DETECCION=0.15
TAU_ROTO=0.35
TAU_SANO=0.85
# Banda de revision: TAU_REVISION <= p(Roto) < TAU_ROTO va a un humano. Sin definir = apagada.
# TAU_REVISION=0.07
COSTO_FALSO_NEGATIVO=12
COSTO_FALSO_POSITIVO=1

# ------------------------------------------------------------- eventos
# memoria = bus in-process (arranca siempre, plan B de la demo)
# kafka   = Redpanda/Kafka real (docker compose up -d primero)
BUS_TIPO=memoria
KAFKA_BOOTSTRAP=localhost:9092
WORKERS_EMBEBIDOS=true

# ------------------------------------------------------------ actuador
# simulado = sin hardware | serial = Arduino/ESP32 conectado
ACTUADOR_TIPO=simulado
# Linux: /dev/ttyUSB0 o /dev/ttyACM0 · Windows: COM3
SERIAL_PUERTO=/dev/ttyUSB0
SERIAL_BAUDIOS=115200

# ------------------------------------------------------------- operacion
BANDA_OBJETIVO_HUEVOS_HORA=9000
GUARDAR_TODAS_LAS_EVIDENCIAS=false
CORS_ORIGINS=*
